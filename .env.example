# ===== Talos: copia este archivo a .env y llena lo que necesites =====

ASSISTANT_NAME=Talos
ASSISTANT_USER_NAME=
# La personalidad va en data/persona.md (ver persona.example.md)
TIMEZONE=America/Bogota
# Cómo te llama el asistente (opcional), p. ej. Sir, Jefe, Doctora
USER_TITLE=
# Dónde vives, para el contexto del asistente
HOME_DESCRIPTION=en Medellín, Colombia
# Ciudades para clima y noticias locales: Nombre:lat:lon,Nombre:lat:lon
LOCATIONS=Medellín:6.2442:-75.5812
LOCATION_LABEL=Medellín
# Edición de Google News para titulares nacionales: es-419:CO, es-419:MX, en-US:US...
NEWS_EDITION=es-419:CO
# Moneda local para el precio del dólar (COP incluye la TRM oficial). Vacío = no mostrar
CURRENCY=COP
# Secciones extra de noticias: Etiqueta|búsqueda1,búsqueda2;Otra|búsqueda
EXTRA_NEWS=Inmobiliario|sector inmobiliario Colombia

# Servidor (127.0.0.1 = solo este computador)
API_HOST=127.0.0.1
API_PORT=8000

# ---- Cerebro: TotalGPT (API compatible con OpenAI) ----
TOTALGPT_API_KEY=
TOTALGPT_BASE_URL=https://api.totalgpt.ai/v1
TOTALGPT_MODEL=Gemma-4-Gembrain-31B-it-uncensored-heretic-FP8-Dynamic
# Modelo más barato/rápido para los resúmenes programados (opcional)
TOTALGPT_MODEL_FAST=
# auto | native | prompt  (auto prueba tool-calling nativo y si falla usa etiquetas en el prompt)
LLM_TOOL_MODE=auto
LLM_THINKING=false

# ---- Voz ----
WHISPER_MODEL=turbo          # large-v3-turbo; tiny | base | small | turbo
# STT_ENGINE vacío = mlx en Mac Apple Silicon (GPU, ~1 s); openai = CPU
STT_ENGINE=
LANGUAGE=es                  # es | en | auto (responde en el idioma en que le hables)
# infermatic = Kokoro alojado en TotalGPT (todas las voces, sin modelo local) | local
TTS_PROVIDER=infermatic
TTS_VOICE_ES=em_alex(2)+em_santa(1)
TTS_VOICE_EN=bm_george(2)+bm_fable(1)   # mayordomo británico
TTS_LANG=e                   # solo para el modo local

# ---- Horarios (hora local) ----
DIGEST_HOURS=7,10,13,16,19,22  # boletín: clima, dólar, noticias leídas y resumidas
LOCAL_NEWS_HOUR=12
# LOCAL_NEWS_QUERIES=Medellín,Envigado   (por defecto: las ciudades de LOCATIONS)
JIRA_HOUR=8                  # pendientes de Jira (lun-vie)

# ---- Jira Cloud (opcional) ----
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL es como https://tuempresa.atlassian.net
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY duedate ASC

# ---- Investigación profunda con Claude Code ----
CLAUDE_BIN=claude            # pon la ruta absoluta si corre como servicio (which claude)
CLAUDE_MODEL=sonnet          # usa tu suscripción de claude.ai; sonnet gasta menos cupo que opus
CLAUDE_USE_SUBSCRIPTION=true # ignora ANTHROPIC_API_KEY para no cobrar por API
RESEARCH_TIMEOUT=1800
RESEARCH_TOOLS=WebSearch,WebFetch,Read,Write

# ---- Discord (opcional): te escribe boletines/avisos y le hablas desde el celular ----
# Bot: https://discord.com/developers/applications (activa "Message Content Intent")
DISCORD_BOT_TOKEN=
# Tu ID de usuario (Ajustes > Avanzado > Modo desarrollador; clic derecho en tu nombre > Copiar ID)
DISCORD_USER_ID=
# Opcional: canal de un servidor donde también responde
DISCORD_CHANNEL_ID=
DISCORD_AUDIO=true

NOTIFY_MACOS=true
# Lee boletines y recordatorios en voz alta en el Mac, sin navegador
SPEAK_ON_MAC=true
